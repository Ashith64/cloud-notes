# Flask & Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key
JWT_EXPIRY_DAYS=7

# Database (SQLite locally, MySQL on RDS/Docker)
DATABASE_URL=sqlite:///dev.db

# Storage (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./local_data
S3_BUCKET=

# AWS Configuration
AWS_REGION=ap-south-1
ASG_NAME=
DB_INSTANCE_ID=
