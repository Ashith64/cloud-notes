# Flask & Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key
JWT_EXPIRY_DAYS=7

# Database (SQLite locally, MySQL on RDS/Docker Compose)
DATABASE_URL=sqlite:///dev.db

# Storage (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./local_data
S3_BUCKET=

# AWS Configuration
AWS_REGION=ap-south-1
ASG_NAME=
DB_INSTANCE_ID=

# ── Stage 7: Production / AWS Secrets Manager ──────────────────────────────
# Set these four variables in production to have the app read database
# credentials and SECRET_KEY from AWS Secrets Manager at startup.
# Leave all four unset (or empty) in local development — the env vars above
# are used as-is in that case.
DB_SECRET_ARN=
DB_HOST=
DB_NAME=
APP_SECRET_ARN=
DB_PORT=3306

# COOKIE_SECURE: set to true in production (HTTPS). false for local/Docker HTTP.
COOKIE_SECURE=false
